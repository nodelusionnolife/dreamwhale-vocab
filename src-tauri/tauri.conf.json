{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "梦鲸词汇",
  "version": "0.15.1",
  "identifier": "com.dreamwhale.vocab",
  "build": {
    "beforeDevCommand": "npm run dev:app",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../app-dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "梦鲸词汇", "width": 1180, "height": 820, "minWidth": 360, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost http: https:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "离线词汇练习与梦鲸陪学",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "template": "installer/installer.nsi", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico", "languages": ["SimpChinese"], "displayLanguageSelector": false }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}

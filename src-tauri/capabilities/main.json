{
  "identifier": "main",
  "windows": ["main"],
  "permissions": [
    "core:default", "core:window:allow-destroy",
    "dialog:allow-open", "dialog:allow-save",
    "fs:allow-read-text-file", "fs:allow-write-text-file", "fs:allow-stat",
    "clipboard-manager:allow-write-text",
    { "identifier": "http:default", "allow": [{ "url": "https://**" }, { "url": "http://**" }] }
  ]
}
